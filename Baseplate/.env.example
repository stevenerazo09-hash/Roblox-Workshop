# Copy this file to .env and fill it in. .env is git-ignored; never commit the real key.
# Roblox Open Cloud API key with the "assets" read+write permission for your user.
ROBLOX_API_KEY=
# Your Roblox user id (the asset creator). tools/upload_model.ps1 looks it up from the username if empty.
ROBLOX_USER_ID=
