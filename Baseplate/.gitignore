# Secrets: the Roblox Open Cloud API key lives in .env (never commit it)
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials*

# Blender autosaves and backups
*.blend1
*.blend2

# Studio lock files. Sandbox.rbxl is a binary place file, so the root .gitignore
# keeps it out of git. Save places as .rbxlx when you want them tracked.
*.rbxl.lock
*.rbxlx.lock

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
